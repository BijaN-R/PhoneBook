@* FILE: src/PhoneBook.Web/Components/Pages/Settings.razor *@
@page "/settings"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthorizationPolicies.AdminOnly)]
@inject SettingsService SettingsService
@inject PhoneBookDataTransferService DataTransferService
@inject IPhoneBookDataQualityService DataQualityService
@inject IJSRuntime JS

<PageTitle>تنظیمات دفترچه</PageTitle>

<section class="page-heading">
    <div>
        <span class="eyebrow">صفحه و تایپوگرافی</span>
        <h1>تنظیمات</h1>
        <p>ابعاد، فاصله‌ها و اندازه قلم مستقیماً بر چیدمان خروجی اثر می‌گذارند.</p>
    </div>
</section>

<div class="settings-tabs" role="tablist" aria-label="بخش‌های تنظیمات">
    @foreach ((string Id, string Label) tab in SettingsTabs)
    {
        <button role="tab" aria-selected="@(_activeTab == tab.Id)" class="@(_activeTab == tab.Id ? "active" : null)" @onclick="() => _activeTab = tab.Id">@tab.Label</button>
    }
</div>

@if (_settings is null)
{
    <section class="panel"><p class="muted">در حال بارگذاری تنظیمات…</p></section>
}
else
{
    @if (_activeTab == "layout")
    {
    <section class="settings-sections">
        <div class="panel form-panel">
            <div class="section-title"><h2>ابعاد صفحه</h2></div>
            <div class="form-grid settings-grid">
                <label>عرض صفحه (میلی‌متر)<InputNumber @bind-Value="_settings.PageWidthMm" /></label>
                <label>ارتفاع صفحه (میلی‌متر)<InputNumber @bind-Value="_settings.PageHeightMm" /></label>
                <label>حاشیه بالا<InputNumber @bind-Value="_settings.MarginTopMm" /></label>
                <label>حاشیه پایین<InputNumber @bind-Value="_settings.MarginBottomMm" /></label>
                <label>حاشیه راست<InputNumber @bind-Value="_settings.MarginRightMm" /></label>
                <label>حاشیه چپ<InputNumber @bind-Value="_settings.MarginLeftMm" /></label>
                <label>فاصله گروه‌ها<InputNumber @bind-Value="_settings.GroupGapMm" /></label>
                <label>فاصله داخلی سلول<InputNumber @bind-Value="_settings.CellPaddingMm" /></label>
            </div>
        </div>

        <div class="panel form-panel">
            <div class="section-title"><h2>قلم و نمایش</h2></div>
            <div class="form-grid settings-grid">
                <label>خانواده قلم<InputText @bind-Value="_settings.PrimaryFontFamily" /></label>
                <label>اندازه متن<InputNumber @bind-Value="_settings.DefaultFontSizePt" /></label>
                <label>اندازه عنوان صفحه<InputNumber @bind-Value="_settings.HeaderFontSizePt" /></label>
                <label>اندازه عنوان گروه<InputNumber @bind-Value="_settings.GroupHeaderFontSizePt" /></label>
                <label>کمینه اندازه قلم<InputNumber @bind-Value="_settings.MinFontSizePt" /></label>
            </div>
        </div>
    </section>
    }

    @if (_activeTab == "general")
    {
        <section class="panel form-panel">
            <div class="section-title"><h2>تنظیمات عمومی</h2></div>
            <div class="form-grid settings-grid">
                <label>تعداد اولویت‌های بالا<input type="number" value="3" disabled /></label>
                <label class="check-field wide"><InputCheckbox @bind-Value="_settings.UsePersianDigits" /> نمایش اعداد فارسی در خروجی</label>
            </div>
        </section>
    }

    @if (_activeTab == "data")
    {
    <section class="panel data-management-panel">
        <div class="section-title">
            <div>
                <span class="eyebrow">پشتیبان‌گیری و بازیابی</span>
                <h2>مدیریت داده‌ها</h2>
                <p class="muted">فایل JSON شامل سربرگ، تنظیمات، گروه‌ها و داخلی‌هاست و اطلاعات حساب‌های کاربری را در بر نمی‌گیرد.</p>
            </div>
            <button class="button" disabled="@_transferBusy" @onclick="ExportBackupAsync">دریافت پشتیبان JSON</button>
        </div>

        <div class="import-box">
            <div>
                <strong>بازیابی از فایل JSON</strong>
                <p class="muted">ابتدا فایل را انتخاب و اعتبارسنجی کنید. تا قبل از تأیید نهایی هیچ داده‌ای تغییر نمی‌کند.</p>
            </div>
            <label class="file-picker">
                انتخاب فایل پشتیبان
                <InputFile OnChange="SelectImportFile" accept="application/json,.json" disabled="@_transferBusy" />
            </label>
            @if (_selectedFile is not null)
            {
                <div class="selected-file">
                    <span dir="ltr">@_selectedFile.Name</span>
                    <small>@FormatFileSize(_selectedFile.Size)</small>
                </div>
                <button class="button primary" disabled="@_transferBusy" @onclick="ValidateImportAsync">اعتبارسنجی و پیش‌نمایش</button>
            }
        </div>

        @if (_importPreview is not null)
        {
            <div class="import-preview">
                <div class="import-summary">
                    <article><span>گروه‌ها</span><strong>@ToPersianNumber(_importPreview.Summary.GroupCount)</strong></article>
                    <article><span>داخلی‌ها</span><strong>@ToPersianNumber(_importPreview.Summary.EntryCount)</strong></article>
                    <article><span>گروه فعال / غیرفعال</span><strong>@ToPersianNumber(_importPreview.Summary.ActiveGroupCount) / @ToPersianNumber(_importPreview.Summary.InactiveGroupCount)</strong></article>
                    <article><span>داخلی فعال / غیرفعال</span><strong>@ToPersianNumber(_importPreview.Summary.ActiveEntryCount) / @ToPersianNumber(_importPreview.Summary.InactiveEntryCount)</strong></article>
                </div>

                @if (_importPreview.Issues.Any(issue => issue.Severity == PhoneBookImportIssueSeverity.Error))
                {
                    <div class="import-issues">
                        <h3>خطاها</h3>
                        @foreach (PhoneBookImportIssue issue in _importPreview.Issues.Where(issue => issue.Severity == PhoneBookImportIssueSeverity.Error))
                        {
                            <div class="import-issue error"><strong>خطا</strong>
                                <span>@issue.Message</span>
                                <code dir="ltr">@issue.Path</code>
                            </div>
                        }
                    </div>
                }
                @if (_importPreview.Issues.Any(issue => issue.Severity == PhoneBookImportIssueSeverity.Warning))
                {
                    <div class="import-issues"><h3>هشدارها</h3>
                        @foreach (PhoneBookImportIssue issue in _importPreview.Issues.Where(issue => issue.Severity == PhoneBookImportIssueSeverity.Warning))
                        { <div class="import-issue warning"><strong>هشدار</strong><span>@issue.Message</span><code dir="ltr">@issue.Path</code></div> }
                    </div>
                }

                @if (_importPreview.CanApply)
                {
                    <div class="replace-confirmation">
                        <p><strong>توجه:</strong> این عملیات تمام داده‌های فعلی دفترچه تلفن را با محتوای فایل جایگزین می‌کند و قابل بازگشت نیست.</p>
                        <label class="check-field">
                            <input type="checkbox" @bind="_replaceConfirmed" /> جایگزینی کامل داده‌های فعلی را تأیید می‌کنم.
                        </label>
                        <button class="button danger-button" disabled="@(_transferBusy || !_replaceConfirmed)" @onclick="ApplyImportAsync">بازیابی و جایگزینی داده‌ها</button>
                    </div>
                }
                else
                {
                    <OperationFeedback Message="تا زمانی که خطاهای فایل برطرف نشوند، بازیابی امکان‌پذیر نیست." Kind="error" Blocking="true" />
                }
            </div>
        }

        <OperationFeedback Message="@_transferMessage" Kind="@(_transferHasError ? "error" : "success")" Blocking="@_transferHasError" />
    </section>
    }

    @if (_activeTab == "operations")
    {
        <section class="panel data-quality-panel">
            <div class="section-title"><div><span class="eyebrow">کنترل پیش از انتشار</span><h2>کیفیت داده‌ها</h2><p class="muted">این بررسی فقط گزارش تولید می‌کند و هیچ داده‌ای را تغییر نمی‌دهد.</p></div>
                <button class="button primary" disabled="@_qualityBusy" @onclick="AnalyzeQualityAsync">@(_qualityBusy ? "در حال بررسی…" : "بررسی کیفیت داده‌ها")</button>
            </div>
            @if (_qualityReport is not null)
            {
                <p><strong>@ToPersianNumber(_qualityReport.Issues.Count)</strong> مورد شناسایی شد.</p>
                @if (_qualityReport.Issues.Count == 0) { <div class="empty-state compact">مشکل کیفیت داده‌ای پیدا نشد.</div> }
                else { <div class="quality-list">@foreach (DataQualityIssue issue in _qualityReport.Issues) { <article class="quality-issue @(issue.Severity == DataQualitySeverity.Error ? "error" : "warning")"><strong>@(issue.Severity == DataQualitySeverity.Error ? "خطا" : "هشدار")</strong><span>@issue.Message</span><small>گروه: @(issue.GroupId?.ToString() ?? "—") · داخلی: @(issue.EntryId?.ToString() ?? "—")</small></article> }</div> }
            }
        </section>
    }

    @if (_activeTab is "layout" or "general")
    {
    <div class="sticky-actions">
        <button class="button primary" disabled="@_saving" @onclick="SaveAsync">ذخیره تنظیمات</button>
        <OperationFeedback Message="@_message" Kind="@(_hasError ? "error" : "success")" Blocking="@_hasError" />
        @if (_hasConflict)
        {
            <button class="button" disabled="@_saving" @onclick="ReloadLatestAsync">بارگذاری آخرین نسخه</button>
        }
    </div>
    }
}

@code {
    private AppSettings? _settings;
    private static readonly (string Id, string Label)[] SettingsTabs = [("layout", "نمایش و صفحه‌آرایی"), ("general", "تنظیمات عمومی"), ("data", "مدیریت داده‌ها"), ("operations", "عملیات مدیریتی")];
    private string _activeTab = "layout";
    private DataQualityReport? _qualityReport;
    private bool _qualityBusy;
    private bool _saving;
    private bool _hasError;
    private bool _hasConflict;
    private string? _message;
    private IBrowserFile? _selectedFile;
    private PhoneBookImportPreview? _importPreview;
    private bool _replaceConfirmed;
    private bool _transferBusy;
    private bool _transferHasError;
    private string? _transferMessage;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.GetAsync();
    }

    private async Task AnalyzeQualityAsync()
    {
        if (_qualityBusy) return;
        _qualityBusy = true;
        try { _qualityReport = await DataQualityService.AnalyzeAsync(); }
        finally { _qualityBusy = false; }
    }

    private async Task SaveAsync()
    {
        if (_settings is null || _saving)
        {
            return;
        }

        string? validationError = Validate(_settings);
        if (validationError is not null)
        {
            _hasError = true;
            _message = validationError;
            return;
        }

        _saving = true;
        _message = null;
        _hasConflict = false;
        try
        {
            _settings.PriorityTopLimit = 3;
            await SettingsService.UpdateAsync(_settings);
            _hasError = false;
            _message = "تنظیمات ذخیره شد.";
        }
        catch (ConcurrencyConflictException)
        {
            _hasConflict = true;
            _hasError = true;
            _message = "این مورد توسط کاربر دیگری تغییر کرده است. لطفاً آخرین اطلاعات را بارگذاری کنید.";
        }
        catch (Exception exception)
        {
            _hasError = true;
            _message = exception.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ReloadLatestAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "تغییرات ذخیره‌نشده کنار گذاشته شوند؟"))
        {
            return;
        }
        _settings = await SettingsService.ReloadAsync();
        _hasConflict = false;
        _hasError = false;
        _message = "آخرین نسخه تنظیمات بارگذاری شد.";
    }

    private async Task ExportBackupAsync()
    {
        if (_transferBusy)
        {
            return;
        }

        _transferBusy = true;
        ClearTransferMessage();
        try
        {
            PhoneBookExportResult export = await DataTransferService.ExportAsync();
            await JS.InvokeVoidAsync(
                "phoneBookDownload",
                export.FileName,
                export.ContentType,
                Convert.ToBase64String(export.Content));
            _transferMessage = "فایل پشتیبان JSON آماده و دریافت شد.";
        }
        catch
        {
            ShowTransferError("ساخت فایل پشتیبان انجام نشد. دوباره تلاش کنید.");
        }
        finally
        {
            _transferBusy = false;
        }
    }

    private void SelectImportFile(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
        _importPreview = null;
        _replaceConfirmed = false;
        ClearTransferMessage();
        if (_selectedFile.Size > PhoneBookDataTransferService.MaximumUploadBytes)
        {
            ShowTransferError("حجم فایل JSON نباید بیشتر از ۵ مگابایت باشد.");
        }
    }

    private async Task ValidateImportAsync()
    {
        if (_selectedFile is null || _transferBusy)
        {
            return;
        }

        _transferBusy = true;
        _importPreview = null;
        _replaceConfirmed = false;
        ClearTransferMessage();
        try
        {
            await using Stream stream = _selectedFile.OpenReadStream(
                PhoneBookDataTransferService.MaximumUploadBytes);
            using MemoryStream buffer = new();
            await stream.CopyToAsync(buffer);
            _importPreview = await DataTransferService.ValidateImportAsync(buffer.ToArray());
            _transferMessage = _importPreview.CanApply
                ? "فایل معتبر است؛ پیش‌نمایش را بررسی و در صورت اطمینان تأیید کنید."
                : "فایل دارای خطاست و قابل بازیابی نیست.";
            _transferHasError = !_importPreview.CanApply;
        }
        catch (IOException)
        {
            ShowTransferError("خواندن فایل ممکن نبود یا حجم آن بیش از حد مجاز است.");
        }
        catch
        {
            ShowTransferError("اعتبارسنجی فایل انجام نشد. فایل دیگری انتخاب کنید.");
        }
        finally
        {
            _transferBusy = false;
        }
    }

    private async Task ApplyImportAsync()
    {
        if (_transferBusy || !_replaceConfirmed || _importPreview?.CanApply != true
            || _importPreview.Document is null)
        {
            return;
        }

        _transferBusy = true;
        ClearTransferMessage();
        try
        {
            PhoneBookImportResult result = await DataTransferService.ApplyImportAsync(
                _importPreview.Document);
            _settings = await SettingsService.GetAsync();
            _transferMessage = $"بازیابی کامل شد: {ToPersianNumber(result.Summary.GroupCount)} گروه و {ToPersianNumber(result.Summary.EntryCount)} داخلی جایگزین شدند.";
            _selectedFile = null;
            _importPreview = null;
            _replaceConfirmed = false;
        }
        catch
        {
            ShowTransferError("بازیابی انجام نشد و داده‌های قبلی حفظ شدند.");
        }
        finally
        {
            _transferBusy = false;
        }
    }

    private static string FormatFileSize(long bytes)
    {
        double kilobytes = bytes / 1024d;
        return $"{PersianTextNormalizer.ToPersianDigits(kilobytes.ToString("0.#", CultureInfo.InvariantCulture))} کیلوبایت";
    }

    private static string ToPersianNumber(int value)
    {
        return PersianTextNormalizer.ToPersianDigits(value.ToString(CultureInfo.InvariantCulture));
    }

    private void ClearTransferMessage()
    {
        _transferHasError = false;
        _transferMessage = null;
    }

    private void ShowTransferError(string message)
    {
        _transferHasError = true;
        _transferMessage = message;
    }

    private static string? Validate(AppSettings settings)
    {
        double[] positiveValues =
        [
            settings.PageWidthMm,
            settings.PageHeightMm,
            settings.MinFontSizePt,
            settings.DefaultFontSizePt,
            settings.HeaderFontSizePt,
            settings.GroupHeaderFontSizePt
        ];
        if (positiveValues.Any(value => !double.IsFinite(value) || value <= 0))
        {
            return "ابعاد صفحه و اندازه‌های قلم باید بزرگ‌تر از صفر باشند.";
        }

        double[] nonNegativeValues =
        [
            settings.MarginTopMm,
            settings.MarginBottomMm,
            settings.MarginLeftMm,
            settings.MarginRightMm,
            settings.GroupGapMm,
            settings.CellPaddingMm
        ];
        if (nonNegativeValues.Any(value => !double.IsFinite(value) || value < 0))
        {
            return "حاشیه‌ها و فاصله‌ها نمی‌توانند منفی باشند.";
        }

        if (settings.MarginLeftMm + settings.MarginRightMm >= settings.PageWidthMm
            || settings.MarginTopMm + settings.MarginBottomMm >= settings.PageHeightMm)
        {
            return "مجموع حاشیه‌ها باید از اندازه صفحه کوچک‌تر باشد.";
        }

        if (settings.DefaultFontSizePt < settings.MinFontSizePt
            || settings.HeaderFontSizePt < settings.MinFontSizePt
            || settings.GroupHeaderFontSizePt < settings.MinFontSizePt)
        {
            return "هیچ اندازه قلمی نمی‌تواند از کمینه قلم کوچک‌تر باشد.";
        }

        if (string.IsNullOrWhiteSpace(settings.PrimaryFontFamily))
        {
            return "نام خانواده قلم الزامی است.";
        }

        return null;
    }
}
