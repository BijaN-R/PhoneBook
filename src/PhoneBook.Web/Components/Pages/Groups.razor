@page "/groups"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthorizationPolicies.AdminOnly)]
@inject PhoneBookQueryService QueryService
@inject GroupManagementService GroupService
@inject IJSRuntime JS

<PageTitle>مدیریت گروه‌ها</PageTitle>
<section class="page-heading"><div><span class="eyebrow">ساختار دفترچه</span><h1>گروه‌ها</h1><p>وضعیت، اولویت و ترتیب نمایش گروه‌ها را مدیریت کنید.</p></div></section>

<OperationFeedback Message="@_message" Kind="@(_hasError ? "error" : "success")" Blocking="@_hasError">
    @if (_hasConflict) { <button class="button" disabled="@_busy" @onclick="ReloadAfterConflictAsync">بارگذاری مجدد</button> }
</OperationFeedback>

<section class="panel form-panel">
    <div class="section-title"><div><span class="eyebrow">گروه تازه</span><h2>افزودن گروه</h2></div></div>
    <div class="form-grid group-form-grid">
        <label>عنوان<input @bind="_newGroup.Title" /></label>
        <label>اولویت<input type="number" min="1" @bind="_newGroup.Priority" /></label>
        <label>ترتیب نمایش<input type="number" min="0" @bind="_newGroup.DisplayOrder" /></label>
        <label>ستون پیشنهادی<select @bind="_newGroup.PreferredColumn"><option value="">خودکار</option><option value="Right">راست</option><option value="Middle">میانی</option><option value="Left">چپ</option></select></label>
        <label class="check-field"><input type="checkbox" @bind="_newGroup.Required" /> الزامی</label>
        <label class="check-field"><input type="checkbox" @bind="_newGroup.KeepTogether" /> یکپارچه بماند</label>
        <label class="check-field"><input type="checkbox" @bind="_newGroup.IsActive" /> فعال</label>
        <button class="button primary" disabled="@_busy" @onclick="AddAsync">افزودن گروه</button>
    </div>
</section>

<section class="panel table-panel">
    <div class="section-title"><div><span class="eyebrow">@ToPersian(_groups.Count) گروه</span><h2>فهرست گروه‌ها</h2></div></div>
    @if (_loading) { <p class="muted" role="status">در حال بارگذاری…</p> }
    else if (_groups.Count == 0) { <div class="empty-state compact">موردی با فیلترهای انتخاب‌شده پیدا نشد.</div> }
    else
    {
        <div class="table-scroll"><table><thead><tr><th>عنوان</th><th>وضعیت</th><th>اولویت</th><th>ستون</th><th>الزامی</th><th>ترتیب</th><th>جابجایی</th><th>عملیات</th></tr></thead><tbody>
        @for (int index = 0; index < _groups.Count; index++)
        {
            PhoneBookGroup group = _groups[index]; int rowIndex = index;
            <tr @key="group.Id">
                <td><input aria-label="عنوان گروه @group.Title" @bind="group.Title" /></td>
                <td><span class="state-badge @(group.IsActive ? "active" : "inactive")">@(group.IsActive ? "فعال" : "غیرفعال")</span></td>
                <td><input aria-label="اولویت گروه @group.Title" class="number-input" type="number" min="1" @bind="group.Priority" /></td>
                <td><select aria-label="ستون پیشنهادی گروه @group.Title" @bind="group.PreferredColumn"><option value="">خودکار</option><option value="Right">راست</option><option value="Middle">میانی</option><option value="Left">چپ</option></select></td>
                <td><label class="check-field"><input aria-label="الزامی بودن گروه @group.Title" type="checkbox" @bind="group.Required" /> @(group.Required ? "بله" : "خیر")</label></td>
                <td>@ToPersian(group.DisplayOrder)</td>
                <td class="reorder-actions">
                    <button title="انتقال به ابتدا" aria-label="انتقال @group.Title به ابتدا" disabled="@(_busy || rowIndex == 0)" @onclick="() => MoveBoundaryAsync(group, true)">⇈</button>
                    <button title="انتقال به بالا" aria-label="انتقال @group.Title به بالا" disabled="@(_busy || rowIndex == 0)" @onclick="() => MoveAsync(group, -1)">↑</button>
                    <button title="انتقال به پایین" aria-label="انتقال @group.Title به پایین" disabled="@(_busy || rowIndex == _groups.Count - 1)" @onclick="() => MoveAsync(group, 1)">↓</button>
                    <button title="انتقال به انتها" aria-label="انتقال @group.Title به انتها" disabled="@(_busy || rowIndex == _groups.Count - 1)" @onclick="() => MoveBoundaryAsync(group, false)">⇊</button>
                </td>
                <td class="row-actions">
                    <button class="text-button" disabled="@_busy" @onclick="() => SaveAsync(group)">ذخیره</button>
                    <button class="text-button" disabled="@_busy" @onclick="() => ToggleActiveAsync(group)">@(group.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")</button>
                    <button class="text-button danger" disabled="@(_busy || group.Required || group.Entries.Count > 0)" @onclick="() => DeleteAsync(group)">حذف قطعی</button>
                </td>
            </tr>
        }
        </tbody></table></div>
    }
</section>

@code {
    private readonly PhoneBookGroup _newGroup = new() { Required = true, KeepTogether = true, IsActive = true };
    private IReadOnlyList<PhoneBookGroup> _groups = [];
    private bool _loading = true, _busy, _hasError, _hasConflict;
    private string? _message;

    protected override async Task OnInitializedAsync() { await ReloadAsync(); _loading = false; }
    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newGroup.Title)) { ShowError("عنوان گروه را وارد کنید."); return; }
        await RunAsync(async () => { await GroupService.CreateGroupAsync(_newGroup); _newGroup.Title=""; _newGroup.Priority=0; _newGroup.DisplayOrder=0; await ReloadAsync(); }, "گروه افزوده شد.");
    }
    private Task SaveAsync(PhoneBookGroup group) => RunAsync(async () => { await GroupService.UpdateGroupAsync(GroupUpdateModel.FromEntity(group)); await ReloadAsync(); }, "تغییرات گروه ذخیره شد.");
    private Task ToggleActiveAsync(PhoneBookGroup group) => RunAsync(async () => { group.IsActive=!group.IsActive; await GroupService.UpdateGroupAsync(GroupUpdateModel.FromEntity(group)); await ReloadAsync(); }, group.IsActive ? "گروه غیرفعال شد." : "گروه فعال شد.");
    private Task MoveAsync(PhoneBookGroup group, int offset) => RunAsync(async () => { await GroupService.MoveGroupAsync(group.Id, group.Revision, offset); await ReloadAsync(); }, "ترتیب گروه‌ها تغییر کرد.");
    private Task MoveBoundaryAsync(PhoneBookGroup group, bool top) => RunAsync(async () => { await GroupService.MoveGroupToBoundaryAsync(group.Id, group.Revision, top); await ReloadAsync(); }, "ترتیب گروه‌ها تغییر کرد.");
    private async Task DeleteAsync(PhoneBookGroup group)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"آیا از حذف «{group.Title}» مطمئن هستید؟ این عملیات قابل بازگشت نیست.")) return;
        await RunAsync(async () => { await GroupService.DeleteGroupAsync(group.Id, group.Revision); await ReloadAsync(); }, "گروه حذف شد.");
    }
    private async Task RunAsync(Func<Task> action, string success)
    {
        if (_busy) return; _busy=true; _message=null; _hasConflict=false;
        try { await action(); _hasError=false; _message=success; }
        catch (ConcurrencyConflictException) { _hasConflict=true; ShowError("این مورد توسط کاربر دیگری تغییر کرده است. لطفاً آخرین اطلاعات را بارگذاری کنید."); }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _busy=false; }
    }
    private async Task ReloadAfterConflictAsync() { if (await JS.InvokeAsync<bool>("confirm", "تغییرات ذخیره‌نشده کنار گذاشته شوند؟")) { await ReloadAsync(); _hasConflict=false; _message=null; } }
    private async Task ReloadAsync() => _groups = await QueryService.GetGroupsAsync();
    private void ShowError(string value) { _hasError=true; _message=value; }
    private static string ToPersian(int value) => PersianTextNormalizer.ToPersianDigits(value.ToString(CultureInfo.InvariantCulture));
}
